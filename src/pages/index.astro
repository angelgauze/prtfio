---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";

const bodyTexts: string[] = [
    "Sophomore comp-sci student and hobbyist game developer.",
    "I care deeply about beautiful UI/UX while prioritizing \
    user satisfaction and developer experience.",
];
---

<Layout pageTitle="angelgauze">
    <Hero>
        {bodyTexts.map((text) => <p class="body-text">{text}</p>)}
    </Hero>
</Layout>
