---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
projects.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout pageTitle="Projects">
    <Hero titleText="Selected works.">
        {
            projects.map((project) => (
                <a href={`/projects/${project.id}`} class="project-card">
                    <h2 class="project-title">{project.data.title}</h2>
                    <p class="project-description">
                        {project.data.description}
                    </p>
                    <div class="project-meta">
                        <time datetime={project.data.pubDate.toISOString()}>
                            {project.data.pubDate.toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "short",
                            })}
                        </time>
                        {project.data.tags.length > 0 && (
                            <ul class="project-tags">
                                {project.data.tags.map((tag) => (
                                    <li>{tag}</li>
                                ))}
                            </ul>
                        )}
                    </div>
                </a>
            ))
        }
    </Hero>
</Layout>

<style>
    .project-card {
        text-decoration: none;
        color: var(--text);
        display: block;
        padding-block: var(--size-4);
        &:hover .project-title {
            text-decoration: underline;
        }
        &:not(:last-child) {
            border-bottom: 1px solid var(--bg-1);
        }
    }
    .project-title {
        font-family: var(--font-instrument-serif);
        font-size: var(--font-size-3);
        margin-bottom: var(--size-1);
    }
    .project-description {
        color: var(--muted);
        font-size: var(--font-size-1);
        line-height: var(--font-lineheight-3);
        margin-bottom: var(--size-2);
    }
    .project-meta {
        display: flex;
        gap: var(--size-3);
        align-items: center;
        font-size: 14px;
        color: var(--muted);
    }
    .project-tags {
        list-style: none;
        padding: 0;
        display: flex;
        gap: var(--size-2);
    }
    .project-tags li {
        background: var(--bg-1);
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 12px;
    }
</style>
