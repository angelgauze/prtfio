---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout pageTitle={project.data.title}>
    <article>
        <header>
            <h1 class="title">{project.data.title}</h1>
            <p class="description">{project.data.description}</p>
            <div class="meta">
                <time datetime={project.data.pubDate.toISOString()}>
                    {project.data.pubDate.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                    })}
                </time>
                {project.data.tags.length > 0 && (
                    <ul class="tags">
                        {project.data.tags.map((tag) => (
                            <li>{tag}</li>
                        ))}
                    </ul>
                )}
                {project.data.link && (
                    <a href={project.data.link} class="link" target="_blank">
                        View project
                    </a>
                )}
            </div>
        </header>
        <Content />
    </article>
</Layout>

<style>
    article {
        padding-block: var(--size-8);
    }
    .title {
        font-family: var(--font-instrument-serif);
        font-size: clamp(
            var(--size-8),
            6vw,
            calc(var(--size-10) + var(--size-3))
        );
        line-height: var(--font-lineheight-4);
        margin-bottom: var(--size-2);
    }
    .description {
        color: var(--muted);
        font-size: var(--font-size-3);
        line-height: var(--font-lineheight-4);
        max-width: var(--size-content-2);
        margin-bottom: var(--size-3);
    }
    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--size-3);
        align-items: center;
        font-size: 14px;
        color: var(--muted);
        padding-bottom: var(--size-4);
        border-bottom: 1px solid var(--bg-1);
        margin-bottom: var(--size-6);
    }
    .tags {
        list-style: none;
        padding: 0;
        display: flex;
        gap: var(--size-2);
    }
    .tags li {
        background: var(--bg-1);
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 12px;
    }
    .link {
        color: var(--accent);
        text-decoration: none;
        margin-left: auto;
        &:hover {
            text-decoration: underline;
        }
    }
</style>
