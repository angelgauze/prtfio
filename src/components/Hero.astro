---
import Name from "../assets/name.svg";

interface Props {
    titleText?: string;
    image?: any;
}

const { titleText, image = Name } = Astro.props;
---

<main>
    {
        titleText ? (
            <h1 class="title-text">{titleText}</h1>
        ) : (
            <Name class="title-image" />
        )
    }

    <slot />
</main>

<style>
    main {
        color: var(--text);
        container-type: inline-size;
    }
    .title-image {
        width: 100%;
        height: auto;
        margin-block: 0 var(--size-8);
    }
    .title-text {
        /*font-size-adjust: 0.5;*/
        font-weight: 600;
        font-family: var(--font-instrument-serif);
        font-size: clamp(
            var(--size-8),
            8vw,
            calc(var(--size-10) + var(--size-3))
        );
        line-height: var(--font-lineheight-4);
    }
    main :global(p) {
        color: var(--muted);
        font-family: var(--font-switzer);
        font-size: var(--font-size-1);
        line-height: var(--font-lineheight-3);
        max-width: 28ch;
        &:not(:last-child) {
            margin-bottom: var(--size-3);
        }
    }
    @media (min-width: 705px) {
        main :global(p) {
            font-size: var(--font-size-3);
            line-height: var(--font-lineheight-4);
            max-width: var(--size-content-2);
            &:not(:last-child) {
                margin-bottom: var(--size-4);
            }
        }
    }
    @media (min-width: 1024px) {
        .title-image {
            margin-block: var(--size-4) var(--size-10);
        }
        main :global(p) {
            max-width: var(--size-content-3);
            &:not(:last-child) {
                margin-bottom: var(--size-5);
            }
        }
    }
</style>
