---
import socials from "../data/socials.json";
import nav from "../data/nav.json";

interface Props {
    variant: "navbar" | "footer";
}

const { variant } = Astro.props;
const links = variant === "navbar" ? nav : socials;
const currentPath = Astro.url.pathname;
---

<nav data-variant={variant}>
    <ul>
        {
            links.map((link: { name: string; url: string }) => {
                const isCurrent =
                    variant === "navbar" && link.url === currentPath;
                return (
                    <li>
                        <a
                            href={link.url}
                            aria-current={isCurrent ? "page" : undefined}
                            class:list={{ "is-current": isCurrent }}
                        >
                            {link.name}
                        </a>
                    </li>
                );
            })
        }
    </ul>
</nav>

<style>
    ul {
        padding: 0;
        list-style: none;
        display: flex;
        gap: var(--size-4);
        padding-block: var(--size-4);
    }
    a {
        text-decoration: none;
        font-size: 14px;
        color: var(--text);
        &:hover {
            text-decoration: underline;
        }
    }
    .is-current {
        font-weight: 500;
    }
    nav[data-variant="navbar"] {
        border-bottom: 1px solid var(--bg-1);
    }
    nav[data-variant="footer"] {
        border-top: 1px solid var(--bg-1);
    }
    @media (min-width: 705px) {
        ul {
            padding-block: var(--size-6);
        }
        a {
            font-size: var(--font-size-1);
        }
    }
</style>
